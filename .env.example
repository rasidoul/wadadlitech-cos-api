# WadadliTech Chief of Staff API - environment variables.
# Copy to .env and fill in real values. Never commit .env with real values.

COS_API_KEY=

# HighLevel (LeadConnector) accounts
HIGHLEVEL_WADADLITECH_TOKEN=
HIGHLEVEL_WADADLITECH_LOCATION_ID=
HIGHLEVEL_PARADIGM_TOKEN=
HIGHLEVEL_PARADIGM_LOCATION_ID=
HIGHLEVEL_JERMAINGORDON_TOKEN=
HIGHLEVEL_JERMAINGORDON_LOCATION_ID=

# Database configuration
# Optional: Set custom database path for persistent storage.
# If not set, defaults to data/cos_tasks.db.
# For ephemeral/serverless deployments without persistent volumes, configure
# a remote database or external persistent storage instead of relying on local files.
# Example: COS_DATABASE_PATH=/persistent/data/cos_tasks.db
COS_DATABASE_PATH=

# Google (Gmail + Calendar + Drive) — OAuth 2.0 user authorization.
# GOOGLE_REDIRECT_URI is only used by scripts/test_google_connection.py to
# mint GOOGLE_REFRESH_TOKEN locally; the running API never performs a live
# OAuth redirect and only needs the three variables below at runtime.
# NOTE: After implementing Gmail send, Calendar write, and Reminders sync features,
# you will need to re-authorize to grant additional scopes and obtain a new
# GOOGLE_REFRESH_TOKEN. Changing scope constants alone is insufficient.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Apple Reminders synchronization bridge
# Scoped credentials for iPhone-to-COS task synchronization.
# These must be different from the main COS_API_KEY.
REMINDERS_BRIDGE_API_KEY=

# Agent brief delivery: WadadliTech Maya (MAYA-WD-MKT-001) HighLevel inbound webhook.
# Leave blank to keep briefs stored with delivery_status "PENDING_CONFIGURATION".
MAYA_WD_WEBHOOK_URL=

# TradeHub Chief of Staff integration.
# TRADEHUB_COS_API_KEY must match TradeHub's own COS_API_KEY. Never commit
# the real value.
TRADEHUB_BASE_URL=https://tradehub-7l1b.onrender.com
TRADEHUB_COS_API_KEY=replace-me
TRADEHUB_TIMEOUT_SECONDS=15

# Independent COS-side safety gate for live trade/close execution.
# TradeHub separately enforces its own ALLOW_LIVE_TRADING /
# COS_LIVE_TRADE_EXECUTION_ENABLED - keep this false until live execution is
# a deliberate, reviewed decision.
COS_TRADEHUB_LIVE_EXECUTION_ENABLED=false

# Planning configuration
# Default timezone for planning and scheduling (must be valid IANA timezone).
COS_PLANNING_TIMEZONE=America/New_York

# Dedicated Google Calendar for COS-managed focus blocks.
# If not set, uses primary calendar. Must be accessible by the authorized Google account.
COS_FOCUS_CALENDAR_ID=

# Planning buffer (percentage of available time to reserve for buffer).
# Default 30 means reserve 30% of available time.
COS_PLANNING_BUFFER_PERCENTAGE=30

# Maximum days ahead to fetch calendar events for planning.
COS_PLANNING_LOOKAHEAD_DAYS=14


